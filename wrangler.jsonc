{
  "name": "saas-admin-template",
  "main": "./dist/index.js",
  "assets": {
    "directory": "./dist"
  },
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "EXAMPLE_VALUE": "example_value",
    "COMPANY_NAME": "TIVA",
    "AGENT_MODEL": "claude-opus-5",
    // TIVA Cloud (Manus bridge). The MANUS_API_KEY is a secret, set with
    // `npx wrangler secret put MANUS_API_KEY`. These are safe, optional
    // overrides for accounts on a different Manus endpoint, header or profile.
    "MANUS_BASE_URL": "https://api.manus.ai",
    "MANUS_API_KEY_HEADER": "API_KEY",
    "MANUS_AGENT_PROFILE": "manus-1.6"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "admin-db",
      "database_id": "9503ed5f-3ac1-4f0e-840a-b408aaabc038"
    }
  ],
  // The Founder's dump: uploaded originals, read with Workers AI.
  "r2_buckets": [
    {
      "binding": "DUMP",
      "bucket_name": "tiva-hq-dump"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      "name": "saas-admin-template-customer-workflow",
      "binding": "CUSTOMER_WORKFLOW",
      "class_name": "CustomerWorkflow"
    },
    {
      "name": "saas-admin-template-mission-workflow",
      "binding": "MISSION_WORKFLOW",
      "class_name": "MissionWorkflow"
    }
  ],
  // Hourly heartbeat for the agent team's 24/7 routines.
  "triggers": {
    "crons": ["0 * * * *"]
  }
}
