# Copy to .env and fill in. Generate secrets with:  openssl rand -hex 32
# (DATA_ENCRYPTION_KEY must be exactly 32 characters.)

# Shared Postgres
POSTGRES_USER=tiva
POSTGRES_PASSWORD=change-me-strong-password

# NocoDB
NOCODB_JWT_SECRET=change-me-random-secret

# Hoppscotch
HOPPSCOTCH_JWT_SECRET=change-me-random-secret
HOPPSCOTCH_SESSION_SECRET=change-me-random-secret
HOPPSCOTCH_ENCRYPTION_KEY=change-me-exactly-32-characters!!
HOPPSCOTCH_ORIGINS=http://localhost:5006,http://localhost:5007,http://localhost:5008

# Docmost
DOCMOST_APP_URL=http://localhost:5009
DOCMOST_APP_SECRET=change-me-openssl-rand-hex-32

# Optional Caddy proxy (docker compose --profile proxy up -d)
TIVA_DOMAIN=tools.localhost

# Host ports (change only if they clash with something on the box)
PORT_EXCALIDRAW=5001
PORT_MEMOS=5002
PORT_NOCODB=5003
PORT_POCKETBASE=5004
PORT_APPSMITH=5005
PORT_HOPPSCOTCH_APP=5006
PORT_HOPPSCOTCH_ADMIN=5007
PORT_HOPPSCOTCH_API=5008
PORT_DOCMOST=5009
