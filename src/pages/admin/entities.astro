---
import Layout from '@/layouts/Layout.astro';
import { AddEntityButton } from '@/components/agents/entity-form';
import { EntityService } from '@/lib/services/entity';

const { API_TOKEN, DB } = Astro.locals.runtime.env;
const entities = await new EntityService(DB).getTree();

const kindLabels: Record<string, string> = {
  holding: 'Holding company',
  subholding: 'Category holding',
  subsidiary: 'Operating company',
  brand: 'Brand',
  venture: 'Venture',
};
---

<Layout title="Group Structure">
  <div slot="actions">
    <AddEntityButton
      client:only="react"
      apiToken={API_TOKEN}
      parents={entities.map(({ id, name, depth }) => ({ id, name, depth }))}
    />
  </div>

  <p class="max-w-3xl text-muted-foreground">
    The parent holding company, the category holding companies beneath it, and every operating company,
    brand and venture under those. Every agent sees this structure, so contracts, money, compliance and
    brand work stay tied to the right entity. You can aim a directive at any entity, or give knowledge
    that only applies to missions for it.
  </p>

  <div class="rounded-xl border bg-card shadow">
    <ul class="divide-y">
      {entities.map((entity) => (
        <li class="flex flex-wrap items-start justify-between gap-2 py-4 pr-6" style={`padding-left: ${1.5 + entity.depth * 1.75}rem`}>
          <div class="min-w-0">
            <p class="font-medium">
              {entity.depth > 0 && <span class="text-muted-foreground">└ </span>}{entity.name}
            </p>
            {entity.description && <p class="mt-1 max-w-2xl text-sm text-muted-foreground">{entity.description}</p>}
            <p class="mt-1 font-mono text-xs text-muted-foreground">{entity.id}</p>
          </div>
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="rounded-md border px-2 py-0.5">{kindLabels[entity.kind] ?? entity.kind}</span>
            {entity.category && <span class="rounded-md border px-2 py-0.5">{entity.category}</span>}
            {entity.region && <span class="rounded-md border px-2 py-0.5">{entity.region}</span>}
            {entity.jurisdiction && <span class="rounded-md border px-2 py-0.5">{entity.jurisdiction}</span>}
          </div>
        </li>
      ))}
    </ul>
  </div>
</Layout>
