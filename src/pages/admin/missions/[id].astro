---
import Layout from '@/layouts/Layout.astro';
import { AutoRefresh } from '@/components/agents/auto-refresh';
import { BuildPackActions } from '@/components/agents/build-pack-actions';
import { StatusBadge } from '@/components/agents/status-badge';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

import { AgentService } from '@/lib/services/agent';
import { EntityService } from '@/lib/services/entity';
import { MissionService } from '@/lib/services/mission';
import { buildPack } from '@/lib/agents/build-pack';
import { formatTime } from '@/lib/agents/format';
import { renderMarkdown } from '@/lib/agents/markdown';
import { isActive } from '@/lib/agents/orchestrator';
import { isStudioAgent } from '@/lib/agents/studio';

const { DB } = Astro.locals.runtime.env;
const id = Number(Astro.params.id);

const missionService = new MissionService(DB);
const mission = Number.isInteger(id) ? await missionService.getById(id) : null;
if (!mission) return Astro.redirect('/admin/missions');

const [tasks, agents, entity] = await Promise.all([
  missionService.getTasks(mission.id),
  new AgentService(DB).getAll(),
  mission.entity_id ? new EntityService(DB).getById(mission.entity_id) : null,
]);
const agentsById = new Map(agents.map((agent) => [agent.id, agent]));
const running = isActive(mission);

// Build Studio work ends in a build pack to hand to Claude Code.
const studioDelivered = tasks.some((task) => {
  const agent = agentsById.get(task.agent_id);
  return agent && isStudioAgent(agent) && task.status === 'completed';
});
const pack = !running && studioDelivered
  ? buildPack({ mission, entity, tasks, agents: agentsById, url: Astro.url.href })
  : null;

const phases = [
  { key: 'planning', label: 'Hermes plans' },
  { key: 'executing', label: 'Team executes' },
  { key: 'synthesizing', label: 'Hermes writes the brief' },
  { key: 'completed', label: 'Brief ready' },
];
const phaseIndex = phases.findIndex((phase) => phase.key === mission.status);
---

<Layout title={`#${mission.id} ${mission.title}`}>
  <AutoRefresh client:only="react" active={running} />

  <div class="flex flex-wrap items-center gap-2 text-sm text-muted-foreground">
    <StatusBadge status={mission.status} />
    <StatusBadge status={mission.priority} />
    <span>{entity ? entity.name : 'Whole group'}</span>
    <span>· {mission.origin === 'routine' ? `Routine ${mission.routine_id}` : mission.origin === 'api' ? 'Relayed by assistant' : 'From the Founder'}</span>
    <span>· Created {formatTime(mission.created_at)}</span>
    {mission.completed_at && <span>· Finished {formatTime(mission.completed_at)}</span>}
  </div>

  {mission.status !== 'failed' && (
    <ol class="flex flex-wrap gap-2 text-xs">
      {phases.map((phase, index) => (
        <li class={`rounded-full border px-3 py-1 ${index < phaseIndex || mission.status === 'completed' ? 'bg-muted' : index === phaseIndex ? 'border-primary font-semibold' : 'text-muted-foreground'}`}>
          {index + 1}. {phase.label}{index === phaseIndex && running ? '...' : ''}
        </li>
      ))}
    </ol>
  )}

  {mission.error && (
    <Card className="border-red-500">
      <CardHeader>
        <CardTitle>Mission failed</CardTitle>
        <CardDescription>{mission.error}</CardDescription>
      </CardHeader>
    </Card>
  )}

  <Card>
    <CardHeader><CardTitle>Directive</CardTitle></CardHeader>
    <CardContent><p class="whitespace-pre-wrap">{mission.directive}</p></CardContent>
  </Card>

  {mission.brief && (
    <Card className="border-primary/40">
      <CardHeader>
        <CardTitle>Brief from Hermes</CardTitle>
      </CardHeader>
      <CardContent>
        <div class="agent-prose" set:html={renderMarkdown(mission.brief)} />
      </CardContent>
    </Card>
  )}

  {mission.decisions.length > 0 && (
    <Card>
      <CardHeader>
        <CardTitle>Decisions for you</CardTitle>
      </CardHeader>
      <CardContent class="space-y-3">
        {mission.decisions.map((decision, index) => (
          <div class="rounded-lg border p-4">
            <p class="font-medium">{index + 1}. {decision.question}</p>
            <p class="mt-1 text-sm"><span class="font-medium">Recommendation:</span> {decision.recommendation}</p>
            <p class="mt-1 text-xs text-muted-foreground">Owner: {decision.owner}</p>
          </div>
        ))}
      </CardContent>
    </Card>
  )}

  {pack && (
    <Card id="build-pack">
      <CardHeader>
        <CardTitle>Build pack</CardTitle>
        <CardDescription>
          Everything the team produced for this build, as one document for Claude Code. It builds and
          tests it, and asks you before anything goes live.
        </CardDescription>
      </CardHeader>
      <CardContent className="space-y-4">
        <BuildPackActions client:load pack={pack} fileName={`build-pack-${mission.id}.md`} />
        <ol class="list-decimal space-y-1 pl-5 text-sm text-muted-foreground">
          <li>
            <span class="font-medium text-foreground">On your desktop:</span> ask Claude Code, OpenClaw or Codex
            to "build TIVA build pack #{mission.id}". With the tiva-agent-team skill installed, it fetches the
            pack with <code>tiva.mjs build-pack {mission.id}</code>.
          </li>
          <li>
            <span class="font-medium text-foreground">On your phone or the web:</span> copy the build pack, open
            Claude Code on the product's repository, paste it and say "Build this".
          </li>
        </ol>
      </CardContent>
    </Card>
  )}

  {mission.plan_summary && (
    <Card>
      <CardHeader><CardTitle>Plan</CardTitle></CardHeader>
      <CardContent><p class="whitespace-pre-wrap text-sm">{mission.plan_summary}</p></CardContent>
    </Card>
  )}

  <section class="space-y-4">
    <h3 class="text-xl font-bold tracking-tight">Assignments</h3>
    {tasks.length ? tasks.map((task) => {
      const agent = agentsById.get(task.agent_id);
      return (
        <Card>
          <CardHeader>
            <div class="flex flex-wrap items-start justify-between gap-2">
              <div>
                <CardTitle>{task.title}</CardTitle>
                <CardDescription>
                  <a class="underline" href={`/admin/agents/${task.agent_id}`}>{agent?.name ?? task.agent_id}</a>{agent ? `, ${agent.title}` : ''}
                  {task.depends_on.length > 0 && <> · after {task.depends_on.join(', ')}</>}
                </CardDescription>
              </div>
              <StatusBadge status={task.status} />
            </div>
          </CardHeader>
          <CardContent class="space-y-4">
            <details>
              <summary class="cursor-pointer text-sm font-medium">Instructions from Hermes</summary>
              <p class="mt-2 whitespace-pre-wrap text-sm text-muted-foreground">{task.instructions}</p>
            </details>
            {task.error && <p class="text-sm text-red-600">{task.error}</p>}
            {task.summary && <p class="text-sm"><span class="font-medium">Summary:</span> {task.summary}</p>}
            {task.output && (
              <details open={tasks.length === 1 || !mission.brief}>
                <summary class="cursor-pointer text-sm font-medium">Deliverable</summary>
                <div class="agent-prose mt-3 rounded-md border p-4" set:html={renderMarkdown(task.output)} />
              </details>
            )}
            {task.decisions.length > 0 && (
              <div class="text-sm">
                <p class="font-medium">Raised for the Founder</p>
                <ul class="mt-1 list-disc pl-6 text-muted-foreground">
                  {task.decisions.map((decision) => <li>{decision}</li>)}
                </ul>
              </div>
            )}
          </CardContent>
        </Card>
      );
    }) : (
      <p class="text-sm text-muted-foreground">{running ? 'Hermes is planning the assignments...' : 'No assignments were created.'}</p>
    )}
  </section>
</Layout>
