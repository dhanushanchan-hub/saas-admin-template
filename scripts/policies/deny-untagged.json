{
  "properties": {
    "displayName": "Deny VM create/update without mandatory tags",
    "description": "Blocks Microsoft.Compute/virtualMachines writes that lack the Owner and Environment tags. Applies at subscription scope.",
    "mode": "Indexed",
    "policyType": "Custom",
    "metadata": {
      "category": "Tags",
      "version": "1.0.0"
    },
    "parameters": {
      "requiredTags": {
        "type": "Array",
        "metadata": {
          "displayName": "Required tag names",
          "description": "Every listed tag must be present on the VM."
        },
        "defaultValue": ["Owner", "Environment"]
      }
    },
    "policyRule": {
      "if": {
        "allOf": [
          { "field": "type", "equals": "Microsoft.Compute/virtualMachines" },
          {
            "anyOf": [
              { "field": "tags['Owner']", "exists": "false" },
              { "field": "tags['Environment']", "exists": "false" }
            ]
          }
        ]
      },
      "then": { "effect": "deny" }
    }
  }
}
