---
import {
  ArrowRight,
  BookOpen,
  Bot,
  Building2,
  CalendarClock,
  CircleAlert,
  CircleCheck,
  Code,
  CreditCard,
  Hammer,
  Inbox,
  Loader,
  MessageSquareWarning,
  MessagesSquare,
  Send,
  Target,
  Users,
} from 'lucide-react';

import Layout from '@/layouts/Layout.astro';
import { DeliveryLog } from '@/components/dashboard/delivery-log';
import { StatusBadge } from '@/components/agents/status-badge';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

import { ActivityService } from '@/lib/services/activity';
import { AgentService } from '@/lib/services/agent';
import { DumpService } from '@/lib/services/dump';
import { EntityService } from '@/lib/services/entity';
import { MissionService } from '@/lib/services/mission';
import { EMPTY_COUNTS, OverviewService } from '@/lib/services/overview';
import { RoutineService } from '@/lib/services/routine';
import { DELIVERIES, SNAPSHOT_DATE } from '@/lib/deliveries';
import { ENTITY_KIND_LABELS, formatTime, formatUntil } from '@/lib/agents/format';
import { markdownExcerpt, renderMarkdown } from '@/lib/agents/markdown';
import { ORCHESTRATOR_ID } from '@/lib/agents/prompts';
import { isStudioAgent } from '@/lib/agents/studio';
import { nextRun } from '@/workflows/scheduler';

const { AI, ANTHROPIC_API_KEY, API_TOKEN, COMPANY_NAME, DB, DUMP, MISSION_WORKFLOW } = Astro.locals.runtime.env;
const brand = COMPANY_NAME ? `${COMPANY_NAME} HQ` : 'TIVA HQ';
const now = new Date();

// This is the first page after sign-in, so one part failing to load (say, a
// migration that hasn't been applied yet) mustn't take the whole page down.
const unavailable = new Set<string>();
const load = <T>(part: string, promise: Promise<T>, fallback: T) =>
  promise.catch((error) => {
    console.error(`Master Dashboard: couldn't load ${part}:`, error);
    unavailable.add(part);
    return fallback;
  });

const missionService = new MissionService(DB);
const [stats, decisions, recent, latestMission, agents, entities, routines, activity, dump, counts, byEntity, running] =
  await Promise.all([
    load('missions', missionService.getStats(), { in_flight: 0, completed_24h: 0, failed_24h: 0, total: 0 }),
    load('decisions', missionService.getOpenDecisions(5), []),
    load('missions', missionService.getAll({ limit: 8 }), []),
    load('briefs', missionService.getLatestCompleted(), null),
    load('agents', new AgentService(DB).getAll(), []),
    load('group structure', new EntityService(DB).getTree(), []),
    load('routines', new RoutineService(DB).getAll(), []),
    load('activity', new ActivityService(DB).getRecent(8), []),
    load('dump', new DumpService(DB).stats(), { files: 0, ready: 0, chars: 0 }),
    load('knowledge and customers', new OverviewService(DB).getCounts(), EMPTY_COUNTS),
    load('missions', missionService.getCountsByEntity(), []),
    load('assignments', missionService.getRunningTaskCounts(), []),
  ]);

const plural = (count: number, one: string, many = `${one}s`) =>
  `${count.toLocaleString('en-US')} ${count === 1 ? one : many}`;

const agentsById = new Map(agents.map((agent) => [agent.id, agent]));
const onDuty = agents.filter((agent) => agent.status === 'active');
const paused = agents.filter((agent) => agent.status === 'paused');
const studio = agents.filter(isStudioAgent);
const entityNames = new Map(entities.map((entity) => [entity.id, entity.name]));

// Who's working: agents with an assignment running, and Hermes while it plans
// or writes a brief.
const workingNow = running.map(
  ({ agent_id, running: count }) => `${agentsById.get(agent_id)?.name ?? agent_id}${count > 1 ? ` (${count})` : ''}`,
);
if (
  recent.some((mission) => ['queued', 'planning', 'synthesizing'].includes(mission.status)) &&
  !running.some((row) => row.agent_id === ORCHESTRATOR_ID)
) {
  workingNow.unshift(agentsById.get(ORCHESTRATOR_ID)?.name ?? 'Hermes');
}

const latestBrief = latestMission?.brief ? markdownExcerpt(latestMission.brief) : null;

const schedule = routines
  .map((routine) => ({ routine, next: nextRun(routine, now) }))
  .sort((a, b) => (a.next?.getTime() ?? Infinity) - (b.next?.getTime() ?? Infinity));
const enabledRoutines = routines.filter((routine) => routine.enabled).length;
const upNext = schedule[0]?.next ?? null;

const missionsFor = new Map(byEntity.map((row) => [row.entity_id, row]));
const missionCount = (row?: { total: number; in_flight: number }) =>
  row ? `${plural(row.total, 'mission')}${row.in_flight ? ` · ${row.in_flight} in flight` : ''}` : 'No missions yet';
const shownEntities = entities.slice(0, 12);

const checks = [
  {
    name: 'Claude',
    ok: Boolean(ANTHROPIC_API_KEY),
    fix: "Add the ANTHROPIC_API_KEY secret. Until then the agents can't work and routines are skipped.",
  },
  {
    name: 'API token',
    ok: Boolean(API_TOKEN),
    fix: "Add the API_TOKEN secret. The dashboard's buttons, OpenClaw and n8n use it.",
  },
  {
    name: 'Mission engine',
    ok: Boolean(MISSION_WORKFLOW),
    fix: 'Deploy the Worker so its mission workflow (MISSION_WORKFLOW) exists.',
  },
  {
    name: 'Dump storage',
    ok: Boolean(DUMP),
    fix: 'Connect the tiva-hq-dump R2 bucket (binding DUMP) so files can be uploaded.',
  },
  {
    name: 'File reading',
    ok: Boolean(AI),
    fix: 'Add the Workers AI binding (AI) to read PDFs, photos and voice notes.',
  },
  {
    name: '24/7 routines',
    ok: Boolean(ANTHROPIC_API_KEY) && enabledRoutines > 0,
    fix: ANTHROPIC_API_KEY ? 'Every routine is paused. Turn one on from Routines.' : 'Routines start once Claude is connected.',
  },
  {
    name: 'Build Studio',
    ok: studio.length > 0,
    fix: 'Apply the latest database migration (npm run db:migrate:remote) to add the builder team.',
  },
];
const setup = checks.filter((check) => !check.ok);

const tiles = [
  {
    name: 'Decisions for you',
    value: decisions.length,
    note: decisions.length ? 'Each with a recommendation' : 'Nothing waiting',
    icon: MessageSquareWarning,
    href: '#decisions',
  },
  {
    name: 'Missions in flight',
    value: stats.in_flight,
    note: `${plural(stats.total, 'mission')} so far`,
    icon: Loader,
    href: '/admin/missions',
  },
  {
    name: 'Briefs (24h)',
    value: stats.completed_24h,
    note: stats.failed_24h ? `${stats.failed_24h} failed` : 'None failed',
    icon: CircleCheck,
    href: '/admin/missions?status=completed',
  },
  {
    name: 'Agents on duty',
    value: `${onDuty.length}/${agents.length}`,
    note: workingNow.length ? `${workingNow.length} working now` : 'Standing by',
    icon: Bot,
    href: '/admin/agents',
  },
];

const modules = [
  {
    name: 'Hermes',
    href: '/admin/hermes',
    icon: MessagesSquare,
    description: 'Talk to your Chief of Staff by chat or voice.',
    stat: counts.messages ? `${plural(counts.messages, 'message')} · last ${formatTime(counts.last_message_at)}` : 'No conversation yet',
  },
  {
    name: 'Command Center',
    href: '/admin/command',
    icon: Send,
    description: 'Give the team a directive and tell Hermes what to remember.',
    stat: decisions.length ? `${plural(decisions.length, 'decision')} waiting on you` : 'Nothing waiting on you',
  },
  {
    name: 'Build Studio',
    href: '/admin/studio',
    icon: Hammer,
    description: 'Your app, website and software builders, with build packs for Claude Code.',
    stat: studio.length
      ? `${plural(studio.filter((agent) => agent.status === 'active').length, 'builder')} on duty`
      : 'Needs its database migration',
  },
  {
    name: 'Missions',
    href: '/admin/missions',
    icon: Target,
    description: "Every directive, its plan, the team's work and the brief.",
    stat: `${plural(stats.total, 'mission')} · ${stats.in_flight} in flight`,
  },
  {
    name: 'Agents',
    href: '/admin/agents',
    icon: Bot,
    description: 'The team, their charters and what each has learned.',
    stat: `${onDuty.length} of ${agents.length} on duty`,
  },
  {
    name: 'Knowledge',
    href: '/admin/knowledge',
    icon: BookOpen,
    description: 'Train the team and review what it learns.',
    stat: `${counts.knowledge_founder} from you · ${counts.knowledge_learned} learned`,
  },
  {
    name: 'Dump',
    href: '/admin/dump',
    icon: Inbox,
    description: 'Drop in files, photos, voice notes and text for the team to read.',
    stat: `${plural(dump.files, 'file')} · ${dump.ready} searchable`,
  },
  {
    name: 'Routines',
    href: '/admin/routines',
    icon: CalendarClock,
    description: 'The work the team does around the clock, on schedule.',
    stat: `${enabledRoutines} of ${routines.length} on${upNext ? ` · next ${formatUntil(upNext, now)}` : ''}`,
  },
  {
    name: 'Group Structure',
    href: '/admin/entities',
    icon: Building2,
    description: 'The holding company and every business, brand and venture under it.',
    stat: plural(entities.length, 'entity', 'entities'),
  },
  {
    name: 'Customers',
    href: '/admin/customers',
    icon: Users,
    description: 'Customer records and their subscriptions.',
    stat: plural(counts.customers, 'customer'),
  },
  {
    name: 'Subscriptions',
    href: '/admin/subscriptions',
    icon: CreditCard,
    description: 'Subscription plans, prices and features.',
    stat: `${plural(counts.plans, 'plan')} · ${counts.active_subscriptions} active`,
  },
  {
    name: 'API & integrations',
    href: '/admin',
    icon: Code,
    description: 'The REST API that OpenClaw, n8n, Claude Code and the terminal use.',
    stat: API_TOKEN ? 'Token set' : 'Token missing',
  },
];
---

<Layout title="Master Dashboard">
  <div slot="actions" class="flex flex-wrap gap-2">
    <a class={buttonVariants()} href="/admin/hermes"><MessagesSquare /> Talk to Hermes</a>
    <a class={buttonVariants({ variant: 'outline' })} href="/admin/command"><Send /> New directive</a>
    <a class={buttonVariants({ variant: 'outline' })} href="/admin/studio"><Hammer /> New build</a>
  </div>

  <div class="space-y-6">
    <p class="max-w-3xl text-muted-foreground">
      Everything {brand} runs, on one page: what needs you, what the team is doing, what runs next, and
      <a class="underline" href="#built">everything Claude Code has built</a>.
    </p>

    {unavailable.size > 0 && (
      <p class="rounded-md border border-amber-500 p-4 text-sm" role="status">
        Some of the dashboard couldn't load: {[...unavailable].join(', ')}. The database may be missing a
        migration; apply them with <code>npm run db:migrate:remote</code>.
      </p>
    )}

    <section aria-labelledby="system-status" class="rounded-xl border bg-card p-4 text-card-foreground shadow">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
        <h3 id="system-status" class="flex items-center gap-2 font-semibold">
          {setup.length
            ? <CircleAlert className="h-4 w-4 text-amber-600 dark:text-amber-400" aria-hidden="true" />
            : <CircleCheck className="h-4 w-4 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />}
          {setup.length ? `${plural(setup.length, 'thing needs', 'things need')} setting up` : 'All systems ready'}
        </h3>
        <p class="text-xs text-muted-foreground">Checked {formatTime(now)}</p>
      </div>
      <ul class="mt-3 flex flex-wrap gap-2">
        {checks.map((check) => (
          <li class="inline-flex items-center gap-1.5 rounded-md border px-2 py-1 text-xs">
            {check.ok
              ? <CircleCheck className="h-3.5 w-3.5 text-emerald-600 dark:text-emerald-400" aria-hidden="true" />
              : <CircleAlert className="h-3.5 w-3.5 text-amber-600 dark:text-amber-400" aria-hidden="true" />}
            {check.name}
            <span class="sr-only">{check.ok ? ': ready' : ': needs setting up'}</span>
          </li>
        ))}
      </ul>
      {setup.length > 0 && (
        <ul class="mt-3 space-y-1 text-sm text-muted-foreground">
          {setup.map((check) => (
            <li><span class="font-medium text-foreground">{check.name}:</span> {check.fix}</li>
          ))}
        </ul>
      )}
    </section>

    <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
      {tiles.map((tile) => (
        <a href={tile.href} class="rounded-xl border bg-card text-card-foreground shadow transition-colors hover:bg-muted">
          <div class="p-4 sm:p-6">
            <div class="flex items-center justify-between gap-2 pb-2">
              <div class="text-sm font-medium tracking-tight">{tile.name}</div>
              <tile.icon className="h-4 w-4 shrink-0 text-muted-foreground" />
            </div>
            <div class="text-2xl font-bold">{tile.value}</div>
            <p class="mt-1 text-xs text-muted-foreground">{tile.note}</p>
          </div>
        </a>
      ))}
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
      <div class="min-w-0 space-y-6 lg:col-span-2">
        <Card id="decisions" className="scroll-mt-6">
          <CardHeader>
            <CardTitle>Decisions waiting on you</CardTitle>
            <CardDescription>From the latest finished missions, each with the team's recommendation.</CardDescription>
          </CardHeader>
          <CardContent className="space-y-4">
            {decisions.length ? decisions.map(({ mission, decision }) => (
              <div class="rounded-lg border p-4">
                <p class="font-medium">{decision.question}</p>
                <p class="mt-1 text-sm text-muted-foreground">
                  <span class="font-medium text-foreground">Recommendation:</span> {decision.recommendation}
                </p>
                <p class="mt-2 text-xs text-muted-foreground">
                  {decision.owner} · <a class="underline" href={`/admin/missions/${mission.id}`}>#{mission.id} {mission.title}</a>
                </p>
              </div>
            )) : (
              <p class="text-sm text-muted-foreground">Nothing is waiting on you.</p>
            )}
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Latest brief from Hermes</CardTitle>
            <CardDescription>
              {latestMission && latestBrief ? (
                <>
                  <a class="hover:underline" href={`/admin/missions/${latestMission.id}`}>#{latestMission.id} {latestMission.title}</a>
                  {' · '}{formatTime(latestMission.completed_at)}
                </>
              ) : 'Briefs appear here as missions finish.'}
            </CardDescription>
          </CardHeader>
          <CardContent>
            {latestMission && latestBrief ? (
              <>
                <div class="agent-prose" set:html={renderMarkdown(latestBrief.text)} />
                <a class="mt-4 inline-flex items-center gap-1 text-sm font-medium underline" href={`/admin/missions/${latestMission.id}`}>
                  {latestBrief.truncated ? 'Read the full brief' : 'Open the mission'} <ArrowRight className="h-4 w-4" />
                </a>
              </>
            ) : (
              <p class="text-sm text-muted-foreground">
                No briefs yet. Your daily brief lands here once its routine runs, or
                <a class="underline" href="/admin/command">give the team a directive</a> now.
              </p>
            )}
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <div class="flex items-start justify-between gap-2">
              <div class="space-y-1.5">
                <CardTitle>Missions</CardTitle>
                <CardDescription>
                  {stats.in_flight ? `${stats.in_flight} in flight right now.` : 'Nothing in flight right now.'}
                </CardDescription>
              </div>
              <a class="text-sm underline" href="/admin/missions">See all</a>
            </div>
          </CardHeader>
          <CardContent>
            {recent.length ? (
              <ul class="divide-y">
                {recent.map((mission) => (
                  <li class="flex flex-wrap items-center justify-between gap-2 py-3">
                    <div class="min-w-0">
                      <a class="font-medium hover:underline" href={`/admin/missions/${mission.id}`}>#{mission.id} {mission.title}</a>
                      <p class="text-xs text-muted-foreground">
                        {mission.entity_id ? entityNames.get(mission.entity_id) ?? mission.entity_id : 'Whole group'} · {formatTime(mission.created_at)}
                      </p>
                    </div>
                    <StatusBadge status={mission.status} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-muted-foreground">
                No missions yet. <a class="underline" href="/admin/command">Give Hermes your first directive</a>.
              </p>
            )}
          </CardContent>
        </Card>
      </div>

      <div class="min-w-0 space-y-6">
        <Card>
          <CardHeader>
            <CardTitle>Up next</CardTitle>
            <CardDescription>The team's 24/7 routines. Times are UTC.</CardDescription>
          </CardHeader>
          <CardContent className="space-y-3">
            {!ANTHROPIC_API_KEY && routines.length > 0 && (
              <p class="text-sm text-amber-700 dark:text-amber-400">Routines are skipped until Claude is connected.</p>
            )}
            {schedule.length ? (
              <ul class="divide-y">
                {schedule.map(({ routine, next }) => (
                  <li class="flex items-start justify-between gap-3 py-2.5">
                    <div class="min-w-0">
                      <p class="text-sm font-medium">{routine.name}</p>
                      <p class="text-xs capitalize text-muted-foreground">
                        {agentsById.get(routine.agent_id)?.name ?? routine.agent_id} · {routine.cadence}
                      </p>
                    </div>
                    {next ? (
                      <div class="shrink-0 text-right text-xs">
                        <p class="font-medium">{formatUntil(next, now)}</p>
                        <p class="text-muted-foreground">{formatTime(next)}</p>
                      </div>
                    ) : (
                      <StatusBadge status="paused" />
                    )}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-muted-foreground">No routines yet.</p>
            )}
            <a class="inline-block text-sm underline" href="/admin/routines">Manage routines</a>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Group</CardTitle>
            <CardDescription>
              {plural(entities.length, 'entity', 'entities')}. Whole-group work: {missionCount(missionsFor.get(null)).toLowerCase()}.
            </CardDescription>
          </CardHeader>
          <CardContent className="space-y-3">
            <ul class="space-y-2.5">
              {shownEntities.map((entity) => (
                <li class="text-sm" style={`padding-left: ${entity.depth}rem`}>
                  <p class="font-medium">
                    {entity.depth > 0 && <span class="text-muted-foreground">└ </span>}{entity.name}
                  </p>
                  <p class="text-xs text-muted-foreground">
                    {ENTITY_KIND_LABELS[entity.kind] ?? entity.kind} · {missionCount(missionsFor.get(entity.id))}
                  </p>
                </li>
              ))}
            </ul>
            {entities.length > shownEntities.length && (
              <p class="text-xs text-muted-foreground">And {entities.length - shownEntities.length} more.</p>
            )}
            <a class="inline-block text-sm underline" href="/admin/entities">Open the group structure</a>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Team</CardTitle>
            <CardDescription>{onDuty.length} of {agents.length} agents on duty.</CardDescription>
          </CardHeader>
          <CardContent className="space-y-3 text-sm">
            <p>
              <span class="font-medium">Working now:</span>{' '}
              {workingNow.length ? workingNow.join(', ') : 'no one. The team is standing by.'}
            </p>
            {paused.length > 0 && (
              <p><span class="font-medium">Paused:</span> {paused.map((agent) => agent.name).join(', ')}</p>
            )}
            <div class="flex flex-wrap gap-1.5">
              {agents.map((agent) => (
                <a href={`/admin/agents/${agent.id}`} title={agent.title} class="rounded-md border px-2 py-0.5 text-xs transition-colors hover:bg-muted">
                  {agent.name}
                </a>
              ))}
            </div>
          </CardContent>
        </Card>

        <Card>
          <CardHeader>
            <CardTitle>Activity</CardTitle>
            <CardDescription>What the agents have been doing, newest first.</CardDescription>
          </CardHeader>
          <CardContent>
            {activity.length ? (
              <ol class="space-y-3">
                {activity.map((entry) => (
                  <li class="text-sm">
                    <p>
                      {entry.mission_id
                        ? <a class="hover:underline" href={`/admin/missions/${entry.mission_id}`}>{entry.message}</a>
                        : entry.message}
                    </p>
                    <p class="text-xs text-muted-foreground">
                      {entry.agent_id ? `${agentsById.get(entry.agent_id)?.name ?? entry.agent_id} · ` : ''}{formatTime(entry.created_at)}
                    </p>
                  </li>
                ))}
              </ol>
            ) : (
              <p class="text-sm text-muted-foreground">No activity yet.</p>
            )}
          </CardContent>
        </Card>
      </div>
    </div>

    <section aria-labelledby="modules-heading" class="space-y-4">
      <div>
        <h3 id="modules-heading" class="text-xl font-bold tracking-tight">Everything in {brand}</h3>
        <p class="text-sm text-muted-foreground">Every part of the app, with where it stands right now.</p>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        {modules.map((module) => (
          <a href={module.href} class="flex flex-col gap-2 rounded-xl border bg-card p-5 text-card-foreground shadow transition-colors hover:bg-muted">
            <div class="flex items-center gap-2">
              <module.icon className="h-4 w-4 shrink-0 text-muted-foreground" />
              <span class="font-semibold">{module.name}</span>
            </div>
            <p class="text-sm text-muted-foreground">{module.description}</p>
            <p class="mt-auto pt-1 text-xs font-medium">{module.stat}</p>
          </a>
        ))}
      </div>
    </section>

    <DeliveryLog client:load initial={DELIVERIES} snapshotDate={SNAPSHOT_DATE} />
  </div>
</Layout>
